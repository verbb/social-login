{
    "name": "verbb/social-login",
    "description": "Add SSO (Single Sign-On) user login, registration and connecting to social media platforms.",
    "type": "craft-plugin",
    "version": "3.0.0-alpha.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin"
    ],
    "support": {
        "email": "support@verbb.io",
        "issues": "https://github.com/verbb/social-login/issues?state=open",
        "source": "https://github.com/verbb/social-login",
        "docs": "https://github.com/verbb/social-login",
        "rss": "https://github.com/verbb/social-login/commits/v2.atom"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Verbb",
            "homepage": "https://verbb.io"
        }
    ],
    "require": {
        "php": "^8.4",
        "craftcms/cms": "6.x-dev",
        "verbb/auth": "dev-craft-6",
        "verbb/base": "dev-craft-6"
    },
    "autoload": {
        "psr-4": {
            "verbb\\sociallogin\\": "src/"
        }
    },
    "extra": {
        "name": "Social Login",
        "handle": "social-login",
        "changelogUrl": "https://raw.githubusercontent.com/verbb/social-login/craft-6/CHANGELOG.md",
        "class": "verbb\\sociallogin\\SocialLogin"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
